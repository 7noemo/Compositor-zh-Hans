<?xml version="1.0" encoding="utf-8"?>
<!--
  空 appcast。

  Compositor 用 Sparkle 做自动更新。装了中文语言包之后，
  如果放任官方更新器工作，它会把官方英文版拉下来覆盖掉语言包。
  所以 scripts/install.sh 会做两件事：

    * SUEnableAutomaticChecks = false     —— 不再自动检查
    * SUFeedURL 指向本文件                —— 就算手动点「检查更新」，
                                             也只会得到「已是最新版本」

  这里刻意保持为空 feed（没有任何 <item>）。
  新语言包通过本仓库的 GitHub Releases 分发，见 README。

  想恢复官方更新器，跑 scripts/restore.sh 即可。
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Compositor 简体中文语言包</title>
    <description>本 feed 故意留空。语言包通过本仓库的 GitHub Releases 分发。</description>
    <language>zh-Hans</language>
  </channel>
</rss>
